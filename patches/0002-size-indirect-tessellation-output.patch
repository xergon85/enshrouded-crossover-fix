+// Optional tessellation scratch sizing from the compiled Metal argument layout.
+namespace {
+struct MVKReflectedBufferStride { NSUInteger bytes; bool logged; };
+std::mutex tessStrideLock;
+struct MVKReflectedState { std::unordered_map<NSUInteger, MVKReflectedBufferStride> buffers; size_t owners=0; };
+std::unordered_map<id<MTLComputePipelineState>, MVKReflectedState> tessBufferStrides;
+}
+bool mvkReflectTessOutputStridesEnabled() {
+    static const bool enabled=[](){const char* e=getenv("MVK_DIAG_REFLECT_TESS_OUTPUT_STRIDES");return e&&atoi(e)!=0;}();
+    return enabled;
+}
+void mvkRememberComputeBufferStrides(id<MTLComputePipelineState> state, MTLComputePipelineReflection* reflection) {
+    if(!mvkReflectTessOutputStridesEnabled() || !state)return;
+    std::unordered_map<NSUInteger, MVKReflectedBufferStride> strides;
+    for(MTLArgument* arg in reflection.arguments) {
+        if(arg.type==MTLArgumentTypeBuffer && arg.bufferDataSize>0) {
+            NSUInteger alignment=std::max<NSUInteger>(arg.bufferAlignment,1);
+            NSUInteger size=arg.bufferDataSize;
+            if(size<=NSUIntegerMax-(alignment-1)) {
+                size=((size+alignment-1)/alignment)*alignment;
+                strides[arg.index]={size,false};
+            }
+        }
+    }
+    std::lock_guard<std::mutex> guard(tessStrideLock);
+    // Every new state replaces an entry, including an empty one on missing reflection.
+    // This prevents stale metadata when an Objective-C object address is reused.
+    auto& entry=tessBufferStrides[state];
+    entry.buffers=std::move(strides);
+    ++entry.owners;
+}
+void mvkForgetComputeBufferStrides(id<MTLComputePipelineState> state) {
+    if(!mvkReflectTessOutputStridesEnabled() || !state)return;
+    std::lock_guard<std::mutex> guard(tessStrideLock);
+    auto it=tessBufferStrides.find(state);
+    if(it!=tessBufferStrides.end() && --it->second.owners==0)tessBufferStrides.erase(it);
+}
+NSUInteger mvkTessOutputStride(id<MTLComputePipelineState> state, NSUInteger index, NSUInteger fallback) {
+    if(!mvkReflectTessOutputStridesEnabled())return fallback;
+    std::lock_guard<std::mutex> guard(tessStrideLock);
+    auto it=tessBufferStrides.find(state);
+    if(it==tessBufferStrides.end())return fallback;
+    auto entry=it->second.buffers.find(index);
+    if(entry==it->second.buffers.end())return fallback;
+    if(!entry->second.logged) {
+        fprintf(stderr,"[enshrouded-diag] Tessellation output stride: state=%p buffer=%lu legacy=%lu reflected=%lu.\n",(void*)state,(unsigned long)index,(unsigned long)fallback,(unsigned long)entry->second.bytes);
+        entry->second.logged=true;
+    }
+    return entry->second.bytes;
+}
